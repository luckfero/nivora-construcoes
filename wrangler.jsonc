{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nivora-construcoes",
  // Acompanha o workerd que o wrangler instalado embarca, que vai até
  // 2026-05-22. Com uma data à frente disso o `npm run dev` nem inicia:
  // "The Workers runtime failed to start". Atualizar o wrangler não
  // resolve — o binário é o mesmo. Os outros sites da Varanda usam
  // 2026-05-15/22; esta era a exceção.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  // O endereço `workers.dev` está desligado de propósito. Descobriu-se na
  // varredura de 2026-08-11 que declarar `custom_domain` sem `workers_dev`
  // explícito faz o deploy desativá-lo sozinho; aqui isso vira decisão
  // documentada, porque o endereço antigo carregava o nome da conta pessoal
  // na URL e nenhum link publicado aponta mais para ele. Quem precisar
  // reativar: trocar para `true` e publicar.
  "workers_dev": false,
  // Domínio próprio declarado aqui, e não no painel: no deploy o wrangler
  // cria o registro DNS e pede o certificado sozinho. `custom_domain: true`
  // é o que faz o worker responder direto no endereço; sem essa chave o
  // padrão seria uma rota, que exigiria configurar o DNS à mão.
  //
  "routes": [
    {
      "pattern": "nivora.varandaestudioweb.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
